# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# TELEGRAM_API_ID: Your Telegram API ID from https://my.telegram.org
TELEGRAM_API_ID="21121587
"

# TELEGRAM_API_HASH: Your Telegram API Hash from https://my.telegram.org
TELEGRAM_API_HASH="3950d42a6d7e59084d881094cd18eb3b"

# SESSION_SECRET: 32+ char secret used to encrypt stored Telegram sessions at rest.
# If unset, sessions remain in memory only and are lost on restart.
SESSION_SECRET=""

# DOWNLOAD_DIR: Optional override for downloads directory (defaults to ~/Downloads/OmniStream)
DOWNLOAD_DIR=""

# DOWNLOAD_CONCURRENCY: Maximum parallel downloads
DOWNLOAD_CONCURRENCY="3"
